rules_version = '2';

// 과학 데이터 스튜디오 — Firestore 보안 규칙 (세션 A, SPEC v1.8 §5.4)
//
// ★ 익명 인증의 한계 (§5.5) — 규칙을 고치기 전에 읽을 것 ★
// 학생은 계정 없이 익명 인증으로 들어오므로, 규칙 입장에서는
// "이 사람이 몇 반 몇 모둠인지" 증명할 방법이 없다. 그래서:
//   - analyses를 ownerUid로 잠그지 않는다. 잠그면 브라우저 데이터가 지워졌을 때
//     자기 모둠이 자기 분석을 못 고치게 되는 더 큰 사고가 난다.
//     (다른 모둠이 덮어쓰는 위험은 화면 제한 + 교사 확인으로 보완)
//   - 코드를 아는 사람의 학급 데이터 읽기는 규칙으로 못 막는다.
//     학급 코드를 외부에 공개하지 않는 것으로 보완한다.
// 감수 가능한 이유: 실명·개인식별 건강정보를 애초에 저장하지 않는다(절대 규칙 3·4).
//
// 요지:
//   - joinCodes: get만 허용(문서 하나 지정). list 차단 → 코드를 모르면 학급을 못 찾는다
//   - teachers: Firebase 콘솔/Admin SDK에서만 등록. 자기 허용 여부 읽기만 가능
//   - classes: get은 인증자 모두, list는 허용된 교사의 자기 학급 조건 쿼리만 통과.
//     만들기·고치기·지우기는 teachers/{uid}에 등록된 계정만 가능
//   - datasets: 읽기는 인증자(학급 비교용), 쓰기는 본인·교사 + 크기 검증
//   - 인증 없는 접근: 전면 차단 (기본 거부)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 익명 로그인이 아닌 실제 계정인가. 이것만으로는 교사라는 뜻이 아니다.
    // 학생도 Google 계정으로 로그인할 수 있으므로 교사 권한에는 approvedTeacher()를 쓴다.
    // 2026-07-27 이 프로젝트의 실제 익명 토큰을 열어 확인한 값:
    //   firebase.sign_in_provider == "anonymous", identities == {}, email 없음
    // 교사(teacher.js)는 구글 로그인만 쓰므로 "google.com"이 들어온다.
    // 'google.com'만 허용하지 않고 "익명이 아님"으로 둔 이유: 나중에 다른 방식으로
    // 교사 로그인을 늘려도 규칙이 막지 않도록 하기 위해서다.
    function realAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 교사 허용 목록. teachers/{uid} 문서는 Firebase 콘솔 또는 Admin SDK로만 만든다.
    // 클라이언트 쓰기 규칙을 열지 않아 사용자가 스스로 교사 권한을 만들 수 없게 한다.
    function approvedTeacher() {
      return realAccount()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // 해당 학급의 교사인가 (classes 문서의 teacherUid와 비교)
    function isTeacherOf(classId) {
      return approvedTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
    }

    // Firestore는 부모 문서가 없어도 하위 컬렉션에 쓸 수 있으므로,
    // 고아 측정·분석 문서가 생기지 않게 쓰기 때 학급 존재를 확인한다.
    function classExists(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId));
    }

    // 측정 문서 쓰기 검증 (§5.2 한도를 규칙으로도 막는다)
    function validDataset() {
      return request.resource.data.keys().hasAll([
          'expNo', 'groupId', 'ownerUid', 'title', 'condition', 'sensor', 'unit',
          'startedAt', 'intervalSec', 'points', 'events', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.expNo is int
        && request.resource.data.expNo in [1, 2, 3, 4] // 4 = 비열 (v2.0)
        && request.resource.data.groupId is string
        && request.resource.data.ownerUid is string
        && request.resource.data.title is string
        && request.resource.data.condition is string
        && request.resource.data.sensor is string
        && request.resource.data.unit is string
        && request.resource.data.startedAt is timestamp
        && request.resource.data.intervalSec is number
        && request.resource.data.intervalSec > 0
        && request.resource.data.points is list
        && request.resource.data.points.size() >= 1
        && request.resource.data.points.size() <= 5000
        && request.resource.data.events is list
        && request.resource.data.source in ['sensor', 'manual', 'mock']
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.createdAt is timestamp;
    }

    // 원본 측정값·센서·소유자·시각은 만든 뒤 바꾸지 않는다(절대 규칙 6).
    // 화면에서 정리할 수 있는 설명용 메타데이터만 수정 가능하게 남긴다.
    function onlyDatasetMetadataChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['title', 'condition', 'status']);
    }

    // 교사 허용 목록은 서버 관리 전용이다. 로그인한 사용자는 자기 등록 여부만 읽는다.
    // create/update/delete 허용 규칙이 없으므로 브라우저에서는 목록을 바꿀 수 없다.
    match /teachers/{teacherId} {
      allow get: if realAccount() && request.auth.uid == teacherId;
    }

    // 입장 코드 → 학급 찾기 (v1.7). 코드를 아는 사람만 문서 하나를 집어 읽는다.
    match /joinCodes/{code} {
      allow get: if signedIn();
      // list는 허용 규칙이 없으므로 차단 — 코드 목록을 긁어갈 수 없다
      allow create: if isTeacherOf(request.resource.data.classId);
      allow update: if isTeacherOf(resource.data.classId)
        && isTeacherOf(request.resource.data.classId);
      allow delete: if isTeacherOf(resource.data.classId);
    }

    match /classes/{classId} {
      // get: 학생이 자기 학급 이름을 불러올 때 (문서 하나 지정)
      allow get: if signedIn();
      // list: 교사가 where("teacherUid","==",본인)으로 거는 쿼리만 통과.
      // 조건 없는 전체 조회는 남의 학급이 섞일 수 있으므로 Firestore가 거부한다.
      allow list: if approvedTeacher() && resource.data.teacherUid == request.auth.uid;
      // 학급 생성·수정·삭제는 교사만.
      // 익명 여부만 보면 Google 계정이 있는 학생도 교사 페이지에서 학급을 만들 수 있다.
      // 허용 목록과 teacherUid를 함께 확인해 승인된 교사만 자기 학급을 만들게 한다.
      allow create: if approvedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if isTeacherOf(classId);

      match /groups/{groupId} {
        allow read: if signedIn();
        allow write: if isTeacherOf(classId);
      }

      match /datasets/{datasetId} {
        allow read: if signedIn();
        // 만들 때는 자기 uid를 ownerUid로 적어야 하고, 크기 검증을 통과해야 한다
        allow create: if signedIn()
          && classExists(classId)
          && request.resource.data.ownerUid == request.auth.uid
          && validDataset();
        // 고치는 것도 같은 검증을 거친다 (본인 또는 교사만)
        allow update: if signedIn()
          && classExists(classId)
          && (resource.data.ownerUid == request.auth.uid || isTeacherOf(classId))
          && request.resource.data.ownerUid == resource.data.ownerUid
          && onlyDatasetMetadataChanged()
          && validDataset();
        allow delete: if signedIn()
          && (resource.data.ownerUid == request.auth.uid || isTeacherOf(classId));
      }

      match /analyses/{analysisId} {
        allow read: if signedIn();
        // 분석은 모둠이 자유롭게 쓰고 고친다 (ownerUid로 잠그지 않는 이유는 맨 위 주석)
        allow create, update: if signedIn() && classExists(classId);
        // 삭제는 교사만 (실수로 모둠 분석이 날아가는 것 방지)
        allow delete: if isTeacherOf(classId);
      }
    }
  }
}
